[
  {
    "id": "deploy-site",
    "execute-command": "/scripts/update-service.sh",
    "command-working-directory": "/",
    "pass-arguments-to-command": [
      {
        "source": "string",
        "name": "site"
      },
      {
        "source": "string",
        "name": "ghcr.io/integrall-tech/archbase-site"
      }
    ],
    "trigger-rule": {
      "match": {
        "type": "value",
        "value": "{{getenv \"WEBHOOK_SECRET\"}}",
        "parameter": {
          "source": "header",
          "name": "x-webhook-secret"
        }
      }
    }
  },
