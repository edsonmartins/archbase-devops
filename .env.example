# Archbase DevOps - Configuração

# GitHub Container Registry
GHCR_USER=maykermiyanaga
GHCR_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxx

# Let's Encrypt
ACME_EMAIL=admin@archbase.dev

# Webhook Secret (usado para autenticar chamadas do GitHub Actions)
# Gere um valor seguro: openssl rand -hex 32
WEBHOOK_SECRET=seu_secret_aqui

# Tags das imagens (opcional, default: latest)
SITE_TAG=latest
REACT_DOCS_TAG=latest
FLUTTER_DOCS_TAG=latest
JAVA_DOCS_TAG=latest
INTEGRALLTECH_TAG=latest
